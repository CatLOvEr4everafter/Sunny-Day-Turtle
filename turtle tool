<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>電子燒烏龜儀式</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@500;700;900&family=Noto+Sans+TC:wght@400;500;600&display=swap');

  :root{
    --ink: #f2e6d3;
    --night: #14100f;
    --night-2: #1d1613;
    --ember: #ff6a3d;
    --ember-2: #ffb347;
    --gold: #d4a750;
    --deep-red: #8c1f2b;
    --paper: #f6e8c9;
    --shell-green: #4a6b3f;
    --shell-dark: #33482c;
  }

  *{ box-sizing:border-box; }

  body{
    margin:0;
    min-height:100vh;
    background:
      radial-gradient(ellipse at 50% 120%, rgba(255,106,61,0.16), transparent 60%),
      radial-gradient(ellipse at 80% -10%, rgba(140,31,43,0.22), transparent 55%),
      var(--night);
    font-family:'Noto Sans TC', sans-serif;
    color: var(--ink);
    padding: 40px 20px 80px;
    display:flex;
    flex-direction:column;
    align-items:center;
    position: relative;
  }

  /* 語言切換選單樣式 */
  .lang-picker {
    position: absolute;
    top: 20px;
    right: 20px;
    display: flex;
    align-items: center;
    gap: 8px;
    z-index: 10;
  }
  .lang-picker select {
    background: var(--night-2);
    color: var(--gold);
    border: 1px solid rgba(212,167,80,0.4);
    padding: 6px 12px;
    border-radius: 4px;
    font-size: 13px;
    outline: none;
    cursor: pointer;
    font-family: 'Noto Sans TC', sans-serif;
  }
  .lang-picker select:hover {
    border-color: var(--ember-2);
  }

  .hero{ text-align:center; margin-bottom: 30px; }
  .hero .eyebrow{ letter-spacing:0.4em; font-size:12px; color:var(--gold); margin-bottom:10px; }
  h1{
    font-family:'Noto Serif TC', serif;
    font-weight:900;
    font-size: clamp(30px, 6.5vw, 48px);
    margin:0;
    background: linear-gradient(180deg, var(--ember-2), var(--ember) 60%, var(--deep-red));
    -webkit-background-clip:text; background-clip:text; color:transparent;
    letter-spacing:0.06em;
  }
  .hero p{
    margin: 10px 0 0;
    font-size: 13px;
    color: rgba(242,230,211,0.5);
  }

  .layout{
    width:100%; max-width: 1000px;
    display:grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 32px;
  }
  @media (max-width: 820px){ .layout{ grid-template-columns: 1fr; } }

  .panel{
    background: var(--night-2);
    border: 1px solid rgba(212,167,80,0.18);
    border-radius: 4px;
    padding: 26px 24px;
  }
  .panel h2{
    font-family:'Noto Serif TC', serif;
    font-size: 14px; letter-spacing:0.2em; color:var(--gold);
    margin: 0 0 20px; font-weight:700;
  }
  label{ display:block; font-size:13px; color:rgba(242,230,211,0.65); margin-bottom:6px; margin-top:16px; }
  label:first-of-type{ margin-top:0; }
  input, textarea{
    width:100%; background:var(--night); border:1px solid rgba(212,167,80,0.3);
    border-radius:3px; padding:11px 12px; color:var(--ink);
    font-family:'Noto Sans TC', sans-serif; font-size:15px; outline:none; transition:border-color .2s;
  }
  input:focus, textarea:focus{ border-color: var(--ember); }
  textarea{ resize:vertical; min-height:64px; }

  #igniteBtn{
    margin-top:24px; width:100%; padding:14px; border:none; border-radius:3px;
    background: linear-gradient(120deg, var(--ember), var(--deep-red));
    color: var(--paper); font-family:'Noto Serif TC', serif; font-weight:700;
    font-size:16px; letter-spacing:0.1em; cursor:pointer; transition: transform .15s, box-shadow .15s, opacity .2s;
  }
  #igniteBtn:hover{ transform: translateY(-1px); box-shadow: 0 8px 24px rgba(255,106,61,0.28); }
  #igniteBtn:disabled{ opacity:0.4; cursor:not-allowed; transform:none; box-shadow:none; }

  /* --- Stage --- */
  .stage-wrap{
    position:relative;
    background: radial-gradient(ellipse at 50% 80%, rgba(255,106,61,0.1), transparent 70%), var(--night-2);
    border: 1px solid rgba(212,167,80,0.18);
    border-radius: 4px;
    min-height: 380px;
    display:flex; align-items:center; justify-content:center;
    overflow:hidden;
  }

  canvas#fx{
    position:absolute; inset:0; width:100%; height:100%; pointer-events:none;
  }

  #turtleBox{
    position:relative;
    width: 180px; height: 180px;
    display:flex; align-items:center; justify-content:center;
    z-index: 2;
  }

  #turtleBox svg{ width:150px; height:150px; filter: drop-shadow(0 6px 14px rgba(0,0,0,0.4)); }

  .charring #turtleBox svg .shell{ transition: fill 2.6s ease; }
  .charring #turtleBox svg .part{ transition: fill 2.6s ease; }
  .charring #turtleBox svg{ animation: shake 0.14s infinite; }
  .charred #turtleBox svg{ animation:none; }

  @keyframes shake{
    0%{ transform: translate(0,0) rotate(0deg); }
    25%{ transform: translate(1.5px,-1px) rotate(-1deg); }
    50%{ transform: translate(-1.5px,1px) rotate(1deg); }
    75%{ transform: translate(1px,1px) rotate(-0.5deg); }
    100%{ transform: translate(0,0) rotate(0deg); }
  }

  .ashout #turtleBox{ animation: sink 1.6s ease forwards; }
  @keyframes sink{
    0%{ opacity:1; transform: scale(1) translateY(0); }
    100%{ opacity:0; transform: scale(0.85) translateY(10px); }
  }

  .stage-wrap.sunny{
    background: radial-gradient(ellipse at 50% 55%, rgba(255,196,102,0.35), transparent 65%), var(--night-2);
    transition: background 1.8s ease;
  }

  #sun{
    position:absolute;
    top:50%; left:50%;
    width: 140px; height:140px;
    transform: translate(-50%,-50%) scale(0.7);
    border-radius:50%;
    background: radial-gradient(circle, #fff3c4 0%, #ffcc66 45%, rgba(255,204,102,0) 72%);
    opacity:0;
    transition: opacity 1.6s ease, transform 1.6s ease;
    z-index:1;
    pointer-events:none;
  }
  #sun.show{ opacity:1; transform: translate(-50%,-50%) scale(1); }
  #sun .ray{
    position:absolute; top:50%; left:50%;
    width:2px; height:70px;
    background: linear-gradient(180deg, rgba(255,204,102,0.55), transparent);
    transform-origin: top center;
    animation: spin 22s linear infinite;
  }
  @keyframes spin{ from{ transform: translate(-50%,0) rotate(0deg); } to{ transform: translate(-50%,0) rotate(360deg); } }

  /* --- Certificate --- */
  .cert{
    position:absolute; inset: 18px;
    background: var(--paper);
    color:#2a1810;
    border-radius:2px;
    padding: 30px 26px;
    display:flex; flex-direction:column;
    opacity:0; pointer-events:none;
    transform: scale(0.96);
    transition: opacity .6s ease, transform .6s ease;
    z-index: 3;
  }
  .cert.show{ opacity:1; transform:scale(1); pointer-events:auto; }
  .cert .seal{
    position:absolute; top:18px; right:20px; width:46px; height:46px; border-radius:50%;
    background: var(--deep-red); color: var(--paper); display:flex; align-items:center; justify-content:center;
    font-family:'Noto Serif TC', serif; font-weight:900; font-size:13px; transform: rotate(-8deg);
    box-shadow: 0 2px 6px rgba(0,0,0,0.35);
  }
  .cert .title{
    font-family:'Noto Serif TC', serif; font-weight:900; font-size:20px; color:var(--deep-red);
    margin: 0 60px 18px 0; letter-spacing:0.08em;
  }
  .cert .row{ display:flex; gap:10px; padding:8px 0; border-top:1px dashed rgba(140,31,43,0.3); font-size:14px; }
  .cert .row:first-of-type{ border-top:none; }
  .cert .row .k{ flex:0 0 70px; font-weight:600; color:var(--deep-red); }
  .cert .row .v{ flex:1; }
  .cert .note{ margin-top:16px; padding-top:12px; border-top:1px solid rgba(140,31,43,0.25); font-size:13px; line-height:1.7; color:#5a4230; white-space:pre-wrap; }
  .cert .stamp{ margin-top:auto; padding-top:14px; text-align:center; font-size:11px; letter-spacing:0.2em; color: rgba(42,24,16,0.4); }

  #stageLabel{
    position:absolute; bottom:16px; left:0; right:0;
    text-align:center; font-size:12px; letter-spacing:0.15em;
    color: rgba(242,230,211,0.45);
    z-index:2;
  }

  .hint{
    max-width:1000px; margin-top:20px; font-size:12px; color: rgba(242,230,211,0.4);
    text-align:center; line-height:1.6;
  }
</style>
</head>
<body>

  <!-- 語言選擇器 -->
  <div class="lang-picker">
    <select id="langSelect" onchange="changeLanguage(this.value)">
      <option value="zh-Hant" selected>繁體中文</option>
      <option value="zh-Hans">简体中文</option>
      <option value="en">English</option>
    </select>
  </div>

  <div class="hero">
    <div class="eyebrow" data-i18n="eyebrow">電 子 儀 式</div>
    <h1 data-i18n="mainTitle">燒烏龜</h1>
    <p data-i18n="subtitle">填妥資訊、點燃儀式之火，祈求活動當天萬里晴空。</p>
  </div>

  <div class="layout">

    <div class="panel">
      <h2 data-i18n="panelTitle">儀 式 資 訊</h2>

      <label for="place" data-i18n="lblPlace">地點</label>
      <input id="place" type="text" data-i18n-ph="phPlace" placeholder="例：河堤空地 / 廟埕廣場">

      <label for="date" data-i18n="lblDate">日期</label>
      <input id="date" type="date">

      <label for="time" data-i18n="lblTime">時間</label>
      <input id="time" type="time">

      <label for="note" data-i18n="lblNote">祈求的活動（選填）</label>
      <textarea id="note" data-i18n-ph="phNote" placeholder="例：週末婚禮、畢業典禮、登山行程——祈求當天放晴"></textarea>

      <button id="igniteBtn" onclick="ignite()" data-i18n="btnIgnite">點 燃 儀 式 之 火 · 祈 晴</button>
    </div>

    <div class="stage-wrap" id="stageWrap">
      <canvas id="fx"></canvas>
      <div id="turtleBox">
        <svg viewBox="0 0 200 200">
          <ellipse class="part" cx="100" cy="150" rx="16" ry="10" fill="#3c5230"/>
          <ellipse class="part" cx="150" cy="150" rx="16" ry="10" fill="#3c5230"/>
          <ellipse class="part" cx="55" cy="130" rx="14" ry="9" fill="#3c5230"/>
          <ellipse class="part" cx="145" cy="130" rx="14" ry="9" fill="#3c5230"/>
          <ellipse class="part" cx="40" cy="95" rx="18" ry="13" fill="#4a6b3f"/>
          <circle class="part" cx="22" cy="90" r="10" fill="#4a6b3f"/>
          <circle class="part" cx="18" cy="86" r="2.4" fill="#1c1c1c"/>
          <ellipse class="shell" cx="115" cy="100" rx="70" ry="55" fill="#4a6b3f" stroke="#33482c" stroke-width="3"/>
          <path class="shell" d="M115 55 L145 85 L145 115 L115 145 L85 115 L85 85 Z" fill="#5b7d4b" stroke="#33482c" stroke-width="2"/>
          <path class="part" d="M60 100 L85 85 M60 100 L85 115 M170 100 L145 85 M170 100 L145 115 M115 55 L115 85 M115 145 L115 115" stroke="#33482c" stroke-width="2" fill="none"/>
        </svg>
      </div>
      <div id="stageLabel" data-i18n="stageIdle">尚未點火</div>

      <div id="sun">
        <div class="ray" style="transform:translate(-50%,0) rotate(0deg)"></div>
        <div class="ray" style="transform:translate(-50%,0) rotate(45deg)"></div>
        <div class="ray" style="transform:translate(-50%,0) rotate(90deg)"></div>
        <div class="ray" style="transform:translate(-50%,0) rotate(135deg)"></div>
      </div>

      <div class="cert" id="cert">
        <div class="seal" data-i18n="certSeal">祈晴</div>
        <div class="title" data-i18n="certTitle">燒烏龜．祈晴儀式證明</div>
        <div class="row"><div class="k" data-i18n="lblPlace">地點</div><div class="v" id="certPlace">—</div></div>
        <div class="row"><div class="k" data-i18n="lblDate">日期</div><div class="v" id="certDate">—</div></div>
        <div class="row"><div class="k" data-i18n="lblTime">時間</div><div class="v" id="certTime">—</div></div>
        <div class="note" id="certNote" style="display:none;"></div>
        <div class="stamp" data-i18n="certStamp">儀 式 圓 滿 · 願 得 晴 空</div>
      </div>
    </div>

  </div>

  <div class="hint" data-i18n="hintText">這是純娛樂用的紓壓小儀式，點火後烏龜會在畫面上化為灰燼，並產生一張可截圖分享的證明卡片。</div>

<script>
// --- 多語言字典設定 ---
const i18n = {
  'zh-Hant': {
    eyebrow: '電 子 儀 式',
    mainTitle: '燒烏龜',
    subtitle: '填妥資訊、點燃儀式之火，祈求活動當天萬里晴空。',
    panelTitle: '儀 式 資 訊',
    lblPlace: '地點',
    phPlace: '例：河堤空地 / 廟埕廣場',
    lblDate: '日期',
    lblTime: '時間',
    lblNote: '祈求的活動（選填）',
    phNote: '例：週末婚禮、畢業典禮、登山行程——祈求當天放晴',
    btnIgnite: '點 燃 儀 式 之 火 · 祈 晴',
    btnAgain: '再 燒 一 次',
    stageIdle: '尚未點火',
    stageBurning: '點火中……',
    stageAshing: '化為灰燼……',
    stageDone: '祈晴完成 ☀',
    certSeal: '祈晴',
    certTitle: '燒烏龜．祈晴儀式證明',
    certStamp: '儀 式 圓 滿 · 願 得 晴 空',
    hintText: '這是純娛樂用的紓壓小儀式，點火後烏龜會在畫面上化為灰燼，並產生一張可截圖分享的證明卡片。',
    unprovided: '未提供',
    year: '年', month: '月', day: '日'
  },
  'zh-Hans': {
    eyebrow: '電 子 仪 式',
    mainTitle: '烧乌龟',
    subtitle: '填妥信息、点燃仪式之火，祈求活动当天万里晴空。',
    panelTitle: '仪 式 信 息',
    lblPlace: '地点',
    phPlace: '例：公园草坪 / 广场',
    lblDate: '日期',
    lblTime: '时间',
    lblNote: '祈求的活动（选填）',
    phNote: '例：周末婚礼、毕业典礼、户外徒步——祈求当天晴朗',
    btnIgnite: '点 燃 仪 式 之 火 · 祈 晴',
    btnAgain: '再 烧 一 次',
    stageIdle: '尚未点火',
    stageBurning: '点火中……',
    stageAshing: '化为灰烬……',
    stageDone: '祈晴完成 ☀',
    certSeal: '祈晴',
    certTitle: '烧乌龟．祈晴仪式证明',
    certStamp: '仪 式 圆 满 · 愿 得 晴 空',
    hintText: '这是纯娱乐用的解压小仪式，点火后乌龟会在屏幕上化为灰烬，并生成一张可截图分享的证明卡片。',
    unprovided: '未提供',
    year: '年', month: '月', day: '日'
  },
  'en': {
    eyebrow: 'DIGITAL RITUAL',
    mainTitle: 'Turtle Burning',
    subtitle: 'Fill in details and ignite the flame to pray for a clear, sunny day.',
    panelTitle: 'RITUAL DETAILS',
    lblPlace: 'Location',
    phPlace: 'e.g., Central Park / Beach',
    lblDate: 'Date',
    lblTime: 'Time',
    lblNote: 'Event (Optional)',
    phNote: 'e.g., Weekend wedding, graduation, hiking trip...',
    btnIgnite: 'IGNITE THE FIRE FOR SUNSHINE',
    btnAgain: 'BURN AGAIN',
    stageIdle: 'Ready',
    stageBurning: 'Igniting...',
    stageAshing: 'Turning to ashes...',
    stageDone: 'Ritual Complete ☀',
    certSeal: 'SUN',
    certTitle: 'Turtle Burning Sunshine Cert',
    certStamp: 'RITUAL COMPLETE · MAY THE SUN SHINE',
    hintText: 'A fun stress-relief ritual. The turtle turns to ash on screen and generates a shareable certificate.',
    unprovided: 'N/A',
    year: '/', month: '/', day: ''
  }
};

let currentLang = 'zh-Hant';
let isFinished = false; // 紀錄是否已完成儀式

function changeLanguage(lang){
  currentLang = lang;
  const dict = i18n[lang];

  // 靜態文字替換
  document.querySelectorAll('[data-i18n]').forEach(el => {
    const key = el.getAttribute('data-i18n');
    if(dict[key]) el.textContent = dict[key];
  });

  // Placeholder 替換
  document.querySelectorAll('[data-i18n-ph]').forEach(el => {
    const key = el.getAttribute('data-i18n-ph');
    if(dict[key]) el.placeholder = dict[key];
  });

  // 按鈕動態狀態文字更新
  const btn = document.getElementById('igniteBtn');
  if(isFinished) {
    btn.textContent = dict.btnAgain;
  }

  // 證書內的日期格式刷新 (如果已填寫)
  const dateVal = document.getElementById('date').value;
  if(dateVal && document.getElementById('certDate').textContent !== dict.unprovided){
    document.getElementById('certDate').textContent = fmtDate(dateVal);
  }
}

const canvas = document.getElementById('fx');
const ctx = canvas.getContext('2d');
const stageWrap = document.getElementById('stageWrap');
let particles = [];
let animRunning = false;

function resizeCanvas(){
  const rect = stageWrap.getBoundingClientRect();
  canvas.width = rect.width;
  canvas.height = rect.height;
}
window.addEventListener('resize', resizeCanvas);
resizeCanvas();

function spawnParticle(cx, cy, kind){
  const angle = Math.random() * Math.PI * 2;
  const speed = kind === 'ember' ? (0.6 + Math.random()*1.4) : (0.2 + Math.random()*0.5);
  particles.push({
    x: cx + (Math.random()-0.5)*40,
    y: cy + (Math.random()-0.5)*20,
    vx: Math.cos(angle)*speed*0.3,
    vy: -Math.abs(Math.sin(angle)*speed) - (kind==='ember'?1.2:0.4),
    life: 0,
    maxLife: kind==='ember' ? (40+Math.random()*30) : (70+Math.random()*50),
    size: kind==='ember' ? (1.5+Math.random()*2.5) : (3+Math.random()*6),
    kind
  });
}

function animate(){
  ctx.clearRect(0,0,canvas.width,canvas.height);
  particles.forEach(p=>{
    p.life++;
    p.x += p.vx;
    p.y += p.vy;
    p.vy *= 0.985;
    p.vx *= 0.99;
    const t = p.life / p.maxLife;
    if(p.kind === 'ember'){
      ctx.globalAlpha = Math.max(0, 1-t);
      const grad = ctx.createRadialGradient(p.x,p.y,0,p.x,p.y,p.size*2);
      grad.addColorStop(0, 'rgba(255,200,120,1)');
      grad.addColorStop(0.5, 'rgba(255,106,61,0.8)');
      grad.addColorStop(1, 'rgba(140,31,43,0)');
      ctx.fillStyle = grad;
      ctx.beginPath();
      ctx.arc(p.x,p.y,p.size,0,Math.PI*2);
      ctx.fill();
    } else {
      ctx.globalAlpha = Math.max(0, 0.35*(1-t));
      ctx.fillStyle = '#5a5a5a';
      ctx.beginPath();
      ctx.arc(p.x,p.y,p.size,0,Math.PI*2);
      ctx.fill();
    }
  });
  ctx.globalAlpha = 1;
  particles = particles.filter(p => p.life < p.maxLife);

  if(animRunning){
    const rect = stageWrap.getBoundingClientRect();
    const cx = rect.width/2;
    const cy = rect.height/2 + 20;
    for(let i=0;i<3;i++) spawnParticle(cx, cy, 'ember');
    if(Math.random() < 0.3) spawnParticle(cx, cy-10, 'smoke');
  }

  if(animRunning || particles.length > 0){
    requestAnimationFrame(animate);
  }
}

function fmtDate(v){
  if(!v) return '';
  const dict = i18n[currentLang];
  const [y,m,d] = v.split('-');
  if(currentLang === 'en') {
    return `${y}/${parseInt(m)}/${parseInt(d)}`;
  }
  return `${y} ${dict.year} ${parseInt(m)} ${dict.month} ${parseInt(d)} ${dict.day}`;
}
function fmtTime(v){
  if(!v) return '';
  return v;
}

function ignite(){
  const btn = document.getElementById('igniteBtn');
  const label = document.getElementById('stageLabel');
  const dict = i18n[currentLang];

  btn.disabled = true;
  label.textContent = dict.stageBurning;
  isFinished = false;

  stageWrap.classList.remove('sunny', 'ashout', 'charred');
  document.getElementById('sun').classList.remove('show');
  document.getElementById('cert').classList.remove('show');
  document.querySelectorAll('#turtleBox .shell, #turtleBox .part').forEach(el => { el.style.fill = ''; });
  void stageWrap.offsetWidth; // reflow

  stageWrap.classList.add('charring');
  animRunning = true;
  animate();

  const shellEls = document.querySelectorAll('#turtleBox .shell, #turtleBox .part');
  requestAnimationFrame(()=>{
    shellEls.forEach(el => { el.style.fill = '#1a1512'; });
  });

  setTimeout(()=>{
    label.textContent = i18n[currentLang].stageAshing;
    stageWrap.classList.remove('charring');
    stageWrap.classList.add('charred');
    stageWrap.classList.add('ashout');
  }, 2600);

  setTimeout(()=>{
    animRunning = false;
    const curDict = i18n[currentLang];
    label.textContent = curDict.stageDone;
    stageWrap.classList.add('sunny');
    document.getElementById('sun').classList.add('show');

    document.getElementById('certPlace').textContent = document.getElementById('place').value.trim() || curDict.unprovided;
    document.getElementById('certDate').textContent = fmtDate(document.getElementById('date').value) || curDict.unprovided;
    document.getElementById('certTime').textContent = fmtTime(document.getElementById('time').value) || curDict.unprovided;

    const note = document.getElementById('note').value.trim();
    const noteEl = document.getElementById('certNote');
    if(note){ noteEl.textContent = note; noteEl.style.display = 'block'; }
    else{ noteEl.style.display = 'none'; }

    document.getElementById('cert').classList.add('show');
    btn.disabled = false;
    isFinished = true;
    btn.textContent = curDict.btnAgain;
  }, 4200);
}
</script>

</body>
</html>
